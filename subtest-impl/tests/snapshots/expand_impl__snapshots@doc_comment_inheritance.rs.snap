#[test]
#[allow(clippy::eq_op)]
/// Documents the parent test fn.
fn parent() {}
mod parent_subtests {
    use super::*;
    #[test]
    #[allow(clippy::eq_op)]
    /// Documents the child subtest fn.
    ///
    /// Doc comments must not count as an attribute override, and must not be inherited themselves.
    fn child() {}
    mod child_subtests {
        use super::*;
        #[test]
        #[allow(clippy::eq_op)]
        fn grandchild() {}
    }
}
