#[rstest]
#[case(1)]
fn value_can_be_incremented(#[case] mut value: u32) {
    value += 1;
    assert!(value > 1);
}
mod value_can_be_incremented_subtests {
    use super::*;
    #[rstest]
    #[case(1)]
    fn value_is_positive(
        #[case]
        #[allow(unused_variables)]
        #[allow(unused_mut)]
        mut value: u32,
    ) {
        assert!(value > 0);
    }
}
