#[test]
fn values_are_assigned() {
    let deferred;
    deferred = "a";
    let nested;
    {
        nested = "b";
    }
    let branched;
    if deferred == "a" {
        branched = "c";
    } else {
        branched = "d";
    }
    let mut counter = 0;
    counter += 1;
    assert_eq!((deferred, nested, branched, counter), ("a", "b", "c", 1));
}
mod values_are_assigned_subtests {
    use super::*;
    #[test]
    fn subtest_reads_none_of_them() {
        let deferred;
        deferred = "a";
        let nested;
        {
            nested = "b";
        }
        let branched;
        if deferred == "a" {
            branched = "c";
        } else {
            branched = "d";
        }
        let mut counter = 0;
        counter += 1;
        assert_eq!(1 + 1, 2);
    }
}
